# Copy to secrets.yaml and fill in. secrets.yaml must NEVER be committed.
# Nach secrets.yaml kopieren und ausfuellen. secrets.yaml gehoert NIE ins Repo.
# Only the Wi-Fi credentials are shared secrets; the API encryption key and
# OTA password are per-device and live in your device YAML (wizard-generated).
wifi_ssid: "MyWifi"
wifi_password: "MyWifiPassword"
